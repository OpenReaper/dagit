{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dagit-firm-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://delicate-art-6ba2.cloudflareaccess.com",
    "ACCESS_AUD": "8e79bfc50785a14147d3bda36219624576a3c29483ec06fa8e8cd9995bad405b",
    "INITIAL_OWNER_EMAIL": "awc@chaunceylaw.com",
    "INITIAL_OBSERVER_EMAIL": "nic@macula.co.za",
    "PLATFORM_OPERATOR_EMAIL": "nic@macula.co.za"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dagit-firm-production",
      "database_id": "19cf2d52-cf02-4560-bbb9-5335c3efad70"
    }
  ],
  "routes": [
    {
      "pattern": "dagit.macula.co.za/firm/api/*",
      "zone_name": "macula.co.za"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
